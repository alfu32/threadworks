{# composite.file-based: orders childImports, runtimeSupport, owned linkDeclarations, and ownDeclaration into one CommonJS module. #}{% if childImports is not empty %}{{ childImports }}

{% endif %}{{ runtimeSupport }}
{% if linkDeclarations is not empty %}
{{ linkDeclarations }}
{% endif %}
{{ ownDeclaration }}
{% if isCompilationRoot %}
function threadworkRun() {
  const context = createRuntimeContext();
  threadworkInstallShutdownHandlers();
  {{ initializerSymbol }}(context);

  while (threadworkIsRunning()) {
    {{ runSymbol }}(context);
  }

  threadworkNetworkShutdownBegin(10);
  while (threadworkNetworkHasRecentTransit()) {
    {{ runSymbol }}(context);
  }
}

module.exports.threadworkRun = threadworkRun;
if (require.main === module) threadworkRun();
{% endif %}
