{# Shared execution state: modeled nodes decide whether shutdown state stops emission. #}
if (!isset($GLOBALS['threadwork_running'])) {
    $GLOBALS['threadwork_running'] = true;
    $GLOBALS['threadwork_shutdown_signal'] = 0;
    $GLOBALS['threadwork_transit'] = 0;
    $GLOBALS['threadwork_shutdown_previous_transit'] = 0;
    $GLOBALS['threadwork_shutdown_idle_ticks'] = 0;
    $GLOBALS['threadwork_shutdown_remaining_ticks'] = 0;
}

if (!function_exists('createRuntimeContext')) {
/** @brief Create the shared context passed to generated PHP nodes. */
function createRuntimeContext(): array
{
    return ['imports' => []];
}

/** @brief Request shutdown; modeled nodes decide whether they continue emitting packets. */
function threadwork_shutdown_request(): void
{
    $GLOBALS['threadwork_running'] = false;
}

/** @brief Return the last OS shutdown signal received by the runtime, or zero. */
function threadwork_get_shutdown_signal(): int
{
    return (int) ($GLOBALS['threadwork_shutdown_signal'] ?? 0);
}

/** @brief Return whether the runtime is still accepting normal work. */
function threadwork_is_running(): bool
{
    return (bool) ($GLOBALS['threadwork_running'] ?? false);
}

/** @brief Increment the count of packets completed by modeled transports. */
function threadwork_record_transit(): void
{
    $GLOBALS['threadwork_transit']++;
}

/** @brief Start the bounded idle window used to drain residual network traffic. */
function threadwork_network_shutdown_begin(int $idleTicks): void
{
    $GLOBALS['threadwork_shutdown_previous_transit'] = $GLOBALS['threadwork_transit'];
    $GLOBALS['threadwork_shutdown_idle_ticks'] = $idleTicks;
    $GLOBALS['threadwork_shutdown_remaining_ticks'] = $idleTicks;
}

/** @brief Return true while transport activity or the idle drain window remains. */
function threadwork_network_has_recent_transit(): bool
{
    printf(
        "[threadwork_network_has_recent_transit] transit=%llu previous=%llu remaining=%u\n",
        GLOBALS['threadwork_transit'],
        GLOBALS['threadwork_shutdown_previous_transit'],
        GLOBALS['threadwork_shutdown_remaining_ticks']
    );
    if ($GLOBALS['threadwork_transit'] !== $GLOBALS['threadwork_shutdown_previous_transit']) {
        $GLOBALS['threadwork_shutdown_previous_transit'] = $GLOBALS['threadwork_transit'];
        $GLOBALS['threadwork_shutdown_remaining_ticks'] = $GLOBALS['threadwork_shutdown_idle_ticks'];
        return true;
    }
    if ($GLOBALS['threadwork_shutdown_remaining_ticks'] === 0) return false;
    $GLOBALS['threadwork_shutdown_remaining_ticks']--;
    return true;
}

/** @brief Install SIGINT and SIGTERM handlers when PCNTL is available. */
function threadwork_install_shutdown_handlers(): void
{
    if (!function_exists('pcntl_signal')) return;
    pcntl_async_signals(true);
    $handleSignal = static function (int $signal): void {
        $GLOBALS['threadwork_shutdown_signal'] = $signal;
        threadwork_shutdown_request();
    };
    pcntl_signal(SIGINT, $handleSignal);
    pcntl_signal(SIGTERM, $handleSignal);
}
}
