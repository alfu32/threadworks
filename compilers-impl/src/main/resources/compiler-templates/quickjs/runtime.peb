{# QuickJS has no Node process/module APIs; runtime state is kept on the global object. #}
const threadworkRuntimeKey = Symbol.for("threadwork.runtime");
const threadworkRuntime = globalThis[threadworkRuntimeKey] ??= {
  running: true,
  shutdownSignal: 0,
  transit: 0,
  shutdownPreviousTransit: 0,
  shutdownIdleTicks: 0,
  shutdownRemainingTicks: 0,
};

/** Create the shared context passed to generated QuickJS nodes. */
function createRuntimeContext() {
  return { imports: Object.create(null) };
}

/** Stop generators while already queued packets continue to drain. */
function threadworkShutdownRequest() {
  threadworkRuntime.running = false;
}

/** Return the last OS shutdown signal observed by this runtime, or zero. */
function threadworkGetShutdownSignal() {
  return threadworkRuntime.shutdownSignal || 0;
}

/** Return whether generator ingress is still open. */
function threadworkIsRunning() {
  return threadworkRuntime.running;
}

/** Increment the count of packets completed by modeled transports. */
function threadworkRecordTransit() {
  threadworkRuntime.transit += 1;
}

/** Start the bounded idle window used to drain residual network traffic. */
function threadworkNetworkShutdownBegin(idleTicks) {
  threadworkRuntime.shutdownPreviousTransit = threadworkRuntime.transit;
  threadworkRuntime.shutdownIdleTicks = idleTicks;
  threadworkRuntime.shutdownRemainingTicks = idleTicks;
}

/** Return true while transport activity or the idle drain window remains. */
function threadworkNetworkHasRecentTransit() {
  if (threadworkRuntime.transit !== threadworkRuntime.shutdownPreviousTransit) {
    threadworkRuntime.shutdownPreviousTransit = threadworkRuntime.transit;
    threadworkRuntime.shutdownRemainingTicks = threadworkRuntime.shutdownIdleTicks;
    return true;
  }
  if (threadworkRuntime.shutdownRemainingTicks === 0) return false;
  threadworkRuntime.shutdownRemainingTicks -= 1;
  return true;
}
