        {
            "id": "node_904556ea-a897-47f9-a733-8e0e005e062f",
            "name": "pong",
            "kind": "Processor",
            "parentId": "root",
            "children": [],
            "incomingLinks": [
                "link_718c5de7-18b0-4a52-8337-e7b0c9d08fda",
                "link_245f4370-e4ab-48ba-8a1b-e4011826e037"
            ],
            "outgoingLinks": [],
            "layout": {
                "x": 670.0,
                "y": 732.0,
                "width": 200.0,
                "height": 78.0,
                "closedWidth": 200.0,
                "closedHeight": 78.0,
                "openWidth": 200.0,
                "openHeight": 78.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "single-file",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "bean b;\n\nif (pop(clock, &b) != THREADWORK_OK) {\n    return THREADWORK_OK;\n}\n\nprintf(\"timestamp.received:%lld\\n\", (long long)(b.id));",
                "sourceLanguageId": "",
                "specification": "",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "binaryContent": null,
            "technology": {
                "languageId": "",
                "technologyId": "",
                "compilerId": "",
                "fileExtension": "",
                "contentType": ""
            },
            "revision": {
                "name": "A",
                "date": "20260831"
            },
            "responsible": null,
            "modified": {
                "date": "2026-09-07T01:40:23.653477550Z",
                "user": "devlin"
            },
