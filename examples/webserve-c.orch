        {
            "id": "node_0feec713-8eaa-4bd5-8ea0-b02515bf358a",
            "name": "clockgen",
            "kind": "Processor",
            "parentId": "root",
            "children": [],
            "incomingLinks": [
                "link_0813977e-4696-4150-a75c-d9de8d291880"
            ],
            "outgoingLinks": [
                "link_718c5de7-18b0-4a52-8337-e7b0c9d08fda"
            ],
            "layout": {
                "x": 183.0,
                "y": 702.0,
                "width": 200.0,
                "height": 108.0,
                "closedWidth": 200.0,
                "closedHeight": 108.0,
                "openWidth": 200.0,
                "openHeight": 108.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "single-file",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "\nprintf(\"timestamp.read:%lld\\n\", (long long)(bstate.id));\n\n// pattern set the speed of the show\nusleep(100000);\n\n// pattern shutdown when shutdown requested through signal\nint signal;\nthreadwork_runner__get_shutdown_signal(&threadwork_runner,&signal);\nint is_running;\nthreadwork_runner__is_running(&threadwork_runner,&is_running);\nif(signal == 2 || !is_running){\n    return THREADWORK_OK;\n}\nprintf(\"signal:%d,is_running:%d\\n\", signal,is_running);\n\n// pattern request/signal shutdown when internal condition has been reached\nif(bstate.id > 1){\n    threadwork_runner__shutdown_request(&threadwork_runner);\n    return THREADWORK_OK;\n}\n\n\n// main operation\nbstate.id+=1;\n\nprintf(\"timestamp.sent:%lld\\n\", (long long)(bstate.id));\n\npush(clock, &bstate);",
                "sourceLanguageId": "",
                "specification": "",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "binaryContent": null,
            "technology": {
                "languageId": "",
                "technologyId": "",
                "compilerId": "",
                "fileExtension": "",
                "contentType": ""
            },
