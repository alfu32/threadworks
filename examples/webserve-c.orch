            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "\nbstate.id+=1;\n\nprintf(\"timestamp.send:%lld\\n\", (long long)(bstate.id));\n\nint signal;\nthreadwork_runner__get_shutdown_signal(&threadwork_runner,&signal);\nprintf(\"timestamp.send:%d\\n\", signal);\n\n//if(signal){\n//    return THREADWORK_OK;\n//}\n\n\npush(clock, &bstate);",
                "sourceLanguageId": "",
                "specification": "",
                "specificationLanguageId": "markdown",
