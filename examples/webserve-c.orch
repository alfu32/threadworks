            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "",
                "sourceLanguageId": "",
                "specification": "this workflow; \n - reads the system time\n - then packs it up with an uuid\n - then adds a random word\n - then finishes by adding the structure the structure to a file",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "binaryContent": null,
            "technology": {
