                "source": "#ifndef FILE_LIB_H\n#define FILE_LIB_H\n\n#include <stdio.h>\n#include <unistd.h>\n\n#ifndef DEF_THREADWORK_ERROR\n#define THREADWORK_ERROR -1\n#endif\n\n#endif /* FILE_LIB_H */",
