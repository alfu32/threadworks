                "source": "  {% if not link.isCapability %}\n      if (threadwork_buffer_count(&{{ link.aPortSymbol }}) > 0U) {\n          if ({{ link.transportSymbol }}(\n                  &{{ link.aPortSymbol }},\n                  &{{ link.bPortSymbol }}\n              ) != THREADWORK_OK) {\n              return THREADWORK_ERROR;\n          }\n\n          threadwork_transit++;\n      }\n  {% endif %}\n\n",
