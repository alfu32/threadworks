        {
            "id": "node_8a6f71d5-7db6-4802-8929-c0785621adc5",
            "name": "infinite_loop",
            "kind": "Processor",
            "parentId": "root",
            "children": [
                "node_039f3e73-96bd-42be-b05d-54712ea38c6b"
            ],
            "incomingLinks": [
                "link_58ab2b4b-125b-4735-8653-2dedeb08e394",
                "link_1fb16fa5-7a6c-422c-b58d-a3e6d5fd6c75"
            ],
            "outgoingLinks": [],
            "layout": {
                "x": 839.0,
                "y": 1188.0,
                "width": 940.0,
                "height": 221.0,
                "closedWidth": 200.0,
                "closedHeight": 78.0,
                "openWidth": 940.0,
                "openHeight": 221.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "\nsig_interceptor__sigaction_init();\n\nint status;\n\nstatus = tw_init_flow_2(context);\n\nif (status == THREADWORK_OK) {\n    while(running){\n            status = tw_run_flow_2(context);\n    }\n}\n\nusleep(5000);\nprintf(\"\\nexit sequence: beginning networ purge\\n\");\n\nif (status == THREADWORK_OK) {\n    network_purge__begin_shutdown(10U);\n  \n    while (network_purge__has_recent_transit() &&\n           status == THREADWORK_OK) {\n        status = tw_run_flow_2(context);\n    }\n}\n\nusleep(5000);\nprintf(\"\\nexit sequence: network purge ended\\n\");\nusleep(1000000);",
                "sourceLanguageId": "",
                "specification": "",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "technology": {
                "languageId": "",
                "technologyId": "",
                "compilerId": "",
                "fileExtension": "",
                "contentType": ""
