        {
            "id": "node_d08cc800-6995-4814-870f-9a4b457c237a",
            "name": "sig_intercept_lib",
            "kind": "Processor",
            "parentId": "root",
            "children": [],
            "incomingLinks": [],
            "outgoingLinks": [
                "link_58ab2b4b-125b-4735-8653-2dedeb08e394"
