            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "{# Defines one terminal processor. Instantiation is setup code; declaration is recurring code. #}\nstatic int tw_{{ initializerSymbol }}(threadwork_context *context{% for link in incomingDataLinks %}, threadwork_buffer *{{ link.argumentSymbol }}{% endfor %}{% for link in outgoingDataLinks %}, threadwork_buffer *{{ link.argumentSymbol }}{% endfor %}{% for link in dependencyInjectionLinks %}{% if not link.isLibraryCapability %}, {% if link.isSourceCapability %}{{ link.capabilityTypeSymbol }} *{% elseif link.sourceNodeTypeSymbol is not empty %}{{ link.sourceNodeTypeSymbol }}{% else %}void *{% endif %} {{ link.argumentSymbol }}{% endif %}{% endfor %})\n{\n    (void)context;\n{% for link in incomingDataLinks %}    (void){{ link.argumentSymbol }};\n{% endfor %}{% for link in outgoingDataLinks %}    (void){{ link.argumentSymbol }};\n{% endfor %}{% for link in dependencyInjectionLinks %}{% if not link.isLibraryCapability %}    (void){{ link.argumentSymbol }};\n{% endif %}\n{% endfor %}\n\n{% if instantiation is not empty %}{{ instantiationIndent4 }}\n{% endif %}    return THREADWORK_OK;\n}\n\nstatic int tw_{{ runSymbol }}(threadwork_context *context{% for link in incomingDataLinks %}, threadwork_buffer *{{ link.argumentSymbol }}{% endfor %}{% for link in outgoingDataLinks %}, threadwork_buffer *{{ link.argumentSymbol }}{% endfor %}{% for link in dependencyInjectionLinks %}{% if not link.isLibraryCapability %}, {% if link.isSourceCapability %}{{ link.capabilityTypeSymbol }} *{% elseif link.sourceNodeTypeSymbol is not empty %}{{ link.sourceNodeTypeSymbol }}{% else %}void *{% endif %} {{ link.argumentSymbol }}{% endif %}{% endfor %})\n{\n    (void)context;\n{% for link in incomingDataLinks %}    (void){{ link.argumentSymbol }};\n{% endfor %}{% for link in outgoingDataLinks %}    (void){{ link.argumentSymbol }};\n{% endfor %}{% for link in dependencyInjectionLinks %}{% if not link.isLibraryCapability %}    (void){{ link.argumentSymbol }};\n{% endif %}\n{% endfor %}\nif(!running){\n    return THREADWORK_OK;\n}\n{% if declaration is not empty %}{{ declarationIndent4 }}\n{% endif %}    return THREADWORK_OK;\n}",
