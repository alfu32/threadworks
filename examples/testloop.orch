        {
            "id": "node_5076990d-8c33-41a3-925f-95cb7043ee44",
            "name": "network_purge_lib",
            "kind": "Processor",
            "parentId": "root",
            "children": [],
            "incomingLinks": [],
            "outgoingLinks": [
                "link_1fb16fa5-7a6c-422c-b58d-a3e6d5fd6c75"
            ],
            "layout": {
                "x": 2226.0,
                "y": 1167.0,
                "width": 200.0,
                "height": 78.0,
                "closedWidth": 200.0,
                "closedHeight": 78.0,
