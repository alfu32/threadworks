                "initialization": "",
                "initializationLanguageId": "",
                "source": "tcp__accept_connections();\n\n$requests = tcp__download_requests();\n\nforeach ($requests as $request) {\n    $requestsOut[] = $request;\n}\n\n$now = new DateTimeImmutable()->format('Y-m-d H:i:s');\necho \"ticker:{tick_time:\" . ($now) . \",tick_number:\" . (memo__get()).\"}\\n\";\n\n$keep_alive[] = $now;",
