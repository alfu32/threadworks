        {
            "id": "node_f6279658-075b-44d9-a93e-b1e12d47c19c",
            "name": "lib_tcp",
            "kind": "Processor",
            "parentId": "root",
            "children": [],
            "incomingLinks": [],
            "outgoingLinks": [
                "link_8b69fa03-f5ad-474f-91d7-0201eee0fcba",
                "link_f3a46c55-d830-419a-817e-f0a54a9339e0"
            ],
            "layout": {
                "x": 821.0,
                "y": 203.0,
                "width": 200.0,
                "height": 108.0,
                "closedWidth": 200.0,
                "closedHeight": 108.0,
                "openWidth": 200.0,
                "openHeight": 108.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "/* tcp_lib.php\n *\n * Protocol:\n *\n *   request  = uint32_be length + <length bytes>\n *   response = uint32_be length + <length bytes>\n *\n * One request per TCP connection.\n *\n * All sockets are non-blocking.\n * The TCP connection remains open while another worker processes the request.\n */\n\n$GLOBALS['TCP_SERVER_STATE'] = null;\n\n\n/* ============================================================\n * Public API\n * ============================================================ */\n\nfunction init(array $config): void\n{\n    if ($GLOBALS['TCP_SERVER_STATE'] !== null) {\n        throw new RuntimeException('TCP server already initialized');\n    }\n\n    if (!isset($config['port'])) {\n        throw new InvalidArgumentException('TCP config requires port');\n    }\n\n    $config += [\n        'host'              => '0.0.0.0',\n        'backlog'           => 128,\n        'max_request_bytes' => 16 * 1024 * 1024,\n\n        // client connected but has not completed its request\n        'read_timeout'      => 30.0,\n\n        // request delegated, waiting for worker response\n        'response_timeout'  => 300.0,\n\n        // response queued but client is not accepting it\n        'write_timeout'     => 30.0,\n\n        'read_chunk'        => 65536,\n    ];\n\n    $context = stream_context_create([\n        'socket' => [\n            'backlog' => $config['backlog'],\n        ]\n    ]);\n\n    $address = sprintf(\n        'tcp://%s:%d',\n        $config['host'],\n        $config['port']\n    );\n\n    $server = @stream_socket_server(\n        $address,\n        $errno,\n        $errstr,\n        STREAM_SERVER_BIND | STREAM_SERVER_LISTEN,\n        $context\n    );\n\n    if ($server === false) {\n        throw new RuntimeException(\n            \"Cannot create TCP server: $errstr ($errno)\"\n        );\n    }\n\n    stream_set_blocking($server, false);\n\n    $GLOBALS['TCP_SERVER_STATE'] = [\n        'server'      => $server,\n        'config'      => $config,\n\n        /*\n         * connection resource id => connection state\n         */\n        'connections' => [],\n\n        /*\n         * request id => connection resource id\n         */\n        'pending'     => [],\n    ];\n}\n\n\nfunction deinit(): void\n{\n    $state =& $GLOBALS['TCP_SERVER_STATE'];\n\n    if ($state === null) {\n        return;\n    }\n\n    foreach (array_keys($state['connections']) as $connectionId) {\n        __close_connection($connectionId);\n    }\n\n    if (is_resource($state['server'])) {\n        fclose($state['server']);\n    }\n\n    $state = null;\n}\n\n\n/*\n * Accept everything currently waiting in the OS accept queue.\n *\n * Never blocks.\n */\nfunction accept_connections(): int\n{\n    $state =& __state();\n\n    $accepted = 0;\n\n    while (true) {\n\n        $socket = @stream_socket_accept(\n            $state['server'],\n            0\n        );\n\n        if ($socket === false) {\n            break;\n        }\n\n        stream_set_blocking($socket, false);\n\n        $connectionId = get_resource_id($socket);\n        $now = microtime(true);\n\n        $state['connections'][$connectionId] = [\n            'socket'          => $socket,\n\n            'status'          => 'reading',\n\n            'read_buffer'     => '',\n            'expected_length' => null,\n\n            'request_id'      => null,\n\n            'write_buffer'    => '',\n\n            'created_at'      => $now,\n            'last_activity'   => $now,\n            'pending_since'   => null,\n        ];\n\n        $accepted++;\n    }\n\n    return $accepted;\n}\n\n\n/*\n * Returns all complete requests received since the previous poll.\n *\n * [\n *     [\n *         'id'      => '...',\n *         'request' => <PHP string containing arbitrary bytes>\n *     ],\n *     ...\n * ]\n */\nfunction download_requests(): array\n{\n    $state =& __state();\n\n    $requests = [];\n\n    foreach (array_keys($state['connections']) as $connectionId) {\n\n        if (!isset($state['connections'][$connectionId])) {\n            continue;\n        }\n\n        $connection =& $state['connections'][$connectionId];\n\n        if ($connection['status'] !== 'reading') {\n            unset($connection);\n            continue;\n        }\n\n        $socket = $connection['socket'];\n\n        /*\n         * Drain everything currently available from this socket.\n         */\n        while (true) {\n\n            $data = @fread(\n                $socket,\n                $state['config']['read_chunk']\n            );\n\n            if ($data === false) {\n                __close_connection($connectionId);\n                break;\n            }\n\n            /*\n             * Non-blocking socket:\n             * empty string usually just means \"nothing available now\".\n             */\n            if ($data === '') {\n                break;\n            }\n\n            $connection['read_buffer'] .= $data;\n            $connection['last_activity'] = microtime(true);\n\n            /*\n             * First four bytes contain request size.\n             */\n            if ($connection['expected_length'] === null) {\n\n                if (strlen($connection['read_buffer']) < 4) {\n                    continue;\n                }\n\n                $header = substr(\n                    $connection['read_buffer'],\n                    0,\n                    4\n                );\n\n                $decoded = unpack('Nlength', $header);\n\n                $length = $decoded['length'];\n\n                if (\n                    $length >\n                    $state['config']['max_request_bytes']\n                ) {\n                    __close_connection($connectionId);\n                    break;\n                }\n\n                $connection['expected_length'] = $length;\n\n                $connection['read_buffer'] = substr(\n                    $connection['read_buffer'],\n                    4\n                );\n            }\n\n            /*\n             * Do we have the whole request body?\n             */\n            $length = $connection['expected_length'];\n\n            if (strlen($connection['read_buffer']) < $length) {\n                continue;\n            }\n\n            $requestData = substr(\n                $connection['read_buffer'],\n                0,\n                $length\n            );\n\n            /*\n             * This protocol allows exactly one request per connection.\n             */\n            $remaining = substr(\n                $connection['read_buffer'],\n                $length\n            );\n\n            if ($remaining !== '') {\n                __close_connection($connectionId);\n                break;\n            }\n\n            $requestId = __new_request_id();\n\n            $connection['status']        = 'pending';\n            $connection['request_id']    = $requestId;\n            $connection['read_buffer']   = '';\n            $connection['pending_since'] = microtime(true);\n\n            $state['pending'][$requestId] = $connectionId;\n\n            $requests[] = [\n                'id'      => $requestId,\n                'request' => $requestData,\n            ];\n\n            break;\n        }\n\n        /*\n         * Client disappeared before completing its request.\n         */\n        if (\n            isset($state['connections'][$connectionId]) &&\n            $state['connections'][$connectionId]['status'] === 'reading' &&\n            feof($socket)\n        ) {\n            __close_connection($connectionId);\n        }\n\n        unset($connection);\n    }\n\n    return $requests;\n}\n\n\n/*\n * Push exactly one worker response.\n *\n * Expected:\n *\n * [\n *     'id'       => request-id,\n *     'response' => arbitrary PHP string / bytes\n * ]\n *\n * Returns false if the connection no longer exists.\n */\nfunction upload_response(array $response): bool\n{\n    $state =& __state();\n\n    if (!isset($response['id'])) {\n        throw new InvalidArgumentException(\n            'response requires id'\n        );\n    }\n\n    if (!array_key_exists('response', $response)) {\n        throw new InvalidArgumentException(\n            'response requires response'\n        );\n    }\n\n    if (!is_string($response['response'])) {\n        throw new InvalidArgumentException(\n            'response must be a string'\n        );\n    }\n\n    $requestId = $response['id'];\n\n    if (!isset($state['pending'][$requestId])) {\n        /*\n         * Client disconnected, timeout occurred,\n         * or response already delivered.\n         */\n        return false;\n    }\n\n    $connectionId = $state['pending'][$requestId];\n\n    if (!isset($state['connections'][$connectionId])) {\n        unset($state['pending'][$requestId]);\n        return false;\n    }\n\n    $payload = $response['response'];\n    $length = strlen($payload);\n\n    if ($length > 0xFFFFFFFF) {\n        throw new RuntimeException(\n            'Response exceeds 32-bit protocol length'\n        );\n    }\n\n    $connection =& $state['connections'][$connectionId];\n\n    /*\n     * No longer waiting for another application response.\n     */\n    unset($state['pending'][$requestId]);\n\n    $connection['status'] = 'writing';\n\n    $connection['write_buffer'] =\n        pack('N', $length) .\n        $payload;\n\n    $connection['last_activity'] = microtime(true);\n\n    /*\n     * Try immediately.\n     *\n     * If the socket would block, the remaining bytes stay\n     * buffered and tcp_cleanup_dead_connections() will retry.\n     */\n    __flush_connection($connectionId);\n\n    return true;\n}\n\n\n/*\n * Run every polling cycle.\n *\n * Despite the name it also progresses partial non-blocking writes.\n */\nfunction cleanup_dead_connections(): void\n{\n    $state =& __state();\n\n    /*\n     * Retry partially-written responses.\n     */\n    foreach (array_keys($state['connections']) as $connectionId) {\n\n        if (\n            isset($state['connections'][$connectionId]) &&\n            $state['connections'][$connectionId]['status'] === 'writing'\n        ) {\n            __flush_connection($connectionId);\n        }\n    }\n\n    $now = microtime(true);\n\n    foreach (array_keys($state['connections']) as $connectionId) {\n\n        if (!isset($state['connections'][$connectionId])) {\n            continue;\n        }\n\n        $connection = $state['connections'][$connectionId];\n\n        $socket = $connection['socket'];\n\n        if (!is_resource($socket)) {\n            __close_connection($connectionId);\n            continue;\n        }\n\n        if (feof($socket)) {\n            __close_connection($connectionId);\n            continue;\n        }\n\n        switch ($connection['status']) {\n\n            case 'reading':\n\n                if (\n                    $now - $connection['last_activity'] >\n                    $state['config']['read_timeout']\n                ) {\n                    __close_connection($connectionId);\n                }\n\n                break;\n\n\n            case 'pending':\n\n                if (\n                    $now - $connection['pending_since'] >\n                    $state['config']['response_timeout']\n                ) {\n                    __close_connection($connectionId);\n                }\n\n                break;\n\n\n            case 'writing':\n\n                if (\n                    $now - $connection['last_activity'] >\n                    $state['config']['write_timeout']\n                ) {\n                    __close_connection($connectionId);\n                }\n\n                break;\n        }\n    }\n}\n\n\n/* ============================================================\n * Internal functions\n * ============================================================ */\n\nfunction &__state(): array\n{\n    if ($GLOBALS['TCP_SERVER_STATE'] === null) {\n        throw new RuntimeException(\n            'TCP server not initialized'\n        );\n    }\n\n    return $GLOBALS['TCP_SERVER_STATE'];\n}\n\n\nfunction __new_request_id(): string\n{\n    $state =& __state();\n\n    do {\n        $id = bin2hex(random_bytes(16));\n    } while (isset($state['pending'][$id]));\n\n    return $id;\n}\n\n\nfunction __flush_connection(int $connectionId): void\n{\n    $state =& __state();\n\n    if (!isset($state['connections'][$connectionId])) {\n        return;\n    }\n\n    $connection =& $state['connections'][$connectionId];\n\n    if ($connection['status'] !== 'writing') {\n        unset($connection);\n        return;\n    }\n\n    $socket = $connection['socket'];\n\n    while ($connection['write_buffer'] !== '') {\n\n        $written = @fwrite(\n            $socket,\n            $connection['write_buffer']\n        );\n\n        if ($written === false) {\n            __close_connection($connectionId);\n            return;\n        }\n\n        /*\n         * Non-blocking socket currently cannot accept more.\n         */\n        if ($written === 0) {\n            return;\n        }\n\n        $connection['write_buffer'] = substr(\n            $connection['write_buffer'],\n            $written\n        );\n\n        $connection['last_activity'] = microtime(true);\n    }\n\n    /*\n     * Complete response delivered.\n     *\n     * One request / response per connection, so we're done.\n     */\n    __close_connection($connectionId);\n}\n\n\nfunction __close_connection(int $connectionId): void\n{\n    $state =& __state();\n\n    if (!isset($state['connections'][$connectionId])) {\n        return;\n    }\n\n    $connection = $state['connections'][$connectionId];\n\n    if ($connection['request_id'] !== null) {\n        unset(\n            $state['pending'][$connection['request_id']]\n        );\n    }\n\n    if (is_resource($connection['socket'])) {\n        @fclose($connection['socket']);\n    }\n\n    unset(\n        $state['connections'][$connectionId]\n    );\n}",
