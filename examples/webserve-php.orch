            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "function command(): ?string\n{\n    global $argv;\n\n    foreach (array_slice($argv, 1) as $arg) {\n        if (!str_starts_with($arg, '-')) {\n            return $arg;\n        }\n    }\n\n    return null;\n}\n\nfunction option(string $name): ?string\n{\n    global $argv;\n\n    // supports:\n    // --name=value\n    // --name value\n\n    for ($i = 1; $i < count($argv); $i++) {\n\n        if (str_starts_with($argv[$i], $name . '=')) {\n            return substr($argv[$i], strlen($name) + 1);\n        }\n\n        if ($argv[$i] === $name) {\n            $next = $argv[$i + 1] ?? null;\n\n            if ($next !== null && !str_starts_with($next, '-')) {\n                return $next;\n            }\n        }\n    }\n\n    return null;\n}\n\nfunction flag(string $name): bool\n{\n    global $argv;\n\n    return in_array($name, $argv, true);\n}",
                "sourceLanguageId": "",
                "specification": "",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
