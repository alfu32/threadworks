        {
            "id": "node_627a3a3e-718f-4867-a71e-584b2d9b138b",
            "name": "gen_uuid",
            "kind": "Processor",
            "parentId": "root",
            "children": [],
            "incomingLinks": [
                "link_d1b9d286-d43a-439a-bee0-e66bf2943400",
                "link_a7727b35-d417-4af2-ab81-86c2dc30a73d"
            ],
            "outgoingLinks": [
                "link_8e881876-8d2a-41a8-92a4-2ee3f2c839ce"
            ],
            "layout": {
                "x": 908.6666666666665,
                "y": 1212.0,
                "width": 220.0,
                "height": 78.0,
                "closedWidth": 220.0,
                "closedHeight": 78.0,
                "openWidth": 220.0,
                "openHeight": 78.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "if (count($ip_time) === 0) return;\n$item = array_shift($ip_time);\n$item->uuid = vsprintf('%s%s-%s-%s-%s-%s%s%s', str_split(bin2hex(random_bytes(16)), 4));\n$item->random_word_length = random_int(5, 25);\n\necho \"gen_uuid:\" . packet2__to_string($item). \"\\n\";\n$ip_uuid[] = $item;",
                "sourceLanguageId": "",
                "specification": "takes a Packet from ip_time, fills in its uuid field, sets random_word_length to a number between 5 and 25, and pushes the updated packet to ip_uuid",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "binaryContent": null,
            "technology": {
                "languageId": "",
                "technologyId": "",
                "compilerId": "",
                "fileExtension": "",
                "contentType": ""
