        {
            "id": "node_c43e7a55-0e44-428b-972a-6dab999df396",
            "name": "read_time",
            "kind": "Processor",
            "parentId": "root",
            "children": [],
            "incomingLinks": [
                "link_2fae235c-f9aa-43ec-8e5c-a351727369df"
            ],
            "outgoingLinks": [
                "link_d1b9d286-d43a-439a-bee0-e66bf2943400"
            ],
            "layout": {
                "x": 546.0,
                "y": 1073.0,
                "width": 220.0,
                "height": 78.0,
                "closedWidth": 220.0,
                "closedHeight": 78.0,
                "openWidth": 220.0,
                "openHeight": 78.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "$packet = new Packet(date(DATE_ATOM), '', '', 0.0, true);\n\necho \"read_time:\" . packet1__to_string($packet) . \"\\n\";\n\n$ip_time[] = $packet;",
                "sourceLanguageId": "",
                "specification": "reads system time and puts it in a Packet and then pushes it into the ip_time output",
                "specificationLanguageId": "markdown",
