        {
            "id": "node_059814d5-2184-47b6-93b0-f754589cf34f",
            "name": "gen_text",
            "kind": "Processor",
            "parentId": "root",
            "children": [],
            "incomingLinks": [
                "link_8e881876-8d2a-41a8-92a4-2ee3f2c839ce",
                "link_6f1ca2b2-edf2-474b-b933-4bd39ac3426a"
            ],
            "outgoingLinks": [
                "link_dd5fcd39-8d54-4310-b6fe-242d927f0ec5"
            ],
            "layout": {
                "x": 1305.3333333333333,
                "y": 1053.0,
                "width": 220.0,
                "height": 78.0,
                "closedWidth": 220.0,
                "closedHeight": 78.0,
                "openWidth": 220.0,
                "openHeight": 78.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "if (count($ip_uuid) === 0) return;\n$item = array_shift($ip_uuid);\n$consonants = 'bcdfgklmnprstuvxz';\n$vowels = 'aeiou';\n$length = max(0, (int) $item->random_word_length);\n$word = '';\nfor ($i = 0; $i < $length; $i++) {\n    $alphabet = ($i % 2 === 0) ? $consonants : $vowels;\n    $word .= $alphabet[random_int(0, strlen($alphabet) - 1)];\n}\n$item->random_word = $word;\n$item->isok = true;\necho \"gen_text:\" . packet3__to_string($item). \"\\n\";\n$ip_word[] = $item;",
                "sourceLanguageId": "",
                "specification": "takes a Packet from ip_uuid and generates a random word string of length random_word_length using the dictionaries\n\nconsonants=\"bcdfgklmnprstuvxz\"\nvowels=\"aeiou\"\n\nalternating consonants with vowels and starting with a consonant\n\nfinally it pushes the updated Packet to ip_word",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "binaryContent": null,
            "technology": {
                "languageId": "",
                "technologyId": "",
                "compilerId": "",
                "fileExtension": "",
                "contentType": ""
            },
