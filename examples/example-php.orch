        {
            "id": "node_3b600a6f-96a5-42b4-beae-b74338ccf170",
            "name": "write_append_file",
            "kind": "Processor",
            "parentId": "root",
            "children": [],
            "incomingLinks": [
                "link_dd5fcd39-8d54-4310-b6fe-242d927f0ec5",
                "link_3475d6a9-445c-43eb-8486-323b890443a4"
            ],
            "outgoingLinks": [],
            "layout": {
                "x": 1675.0,
                "y": 1223.0,
                "width": 220.0,
                "height": 78.0,
                "closedWidth": 220.0,
                "closedHeight": 78.0,
                "openWidth": 220.0,
                "openHeight": 78.0,
                "isExpanded": true
            },
            "fileLayoutStrategyId": "none",
            "text": {
                "initialization": "",
                "initializationLanguageId": "",
                "source": "$sleepval = 5000;\nforeach ($_SERVER['argv'] ?? [] as $index => $argument) {\n    if ($argument === '--sleep' && isset($_SERVER['argv'][$index + 1])) {\n        $sleepval = (int) $_SERVER['argv'][$index + 1];\n    }\n}\nif (count($ip_word) === 0) return;\n$item = array_shift($ip_word);\necho \"write_csv:\" . packet4__to_string($item). \"\\n\\n\";\n$file = fopen('ticker_out.csv', 'ab');\nif ($file === false) return;\nfputcsv($file, [$item->timestamp, $item->uuid, $item->random_word, $item->random_word_length, $item->isok ? 'true' : 'false'], ',', '\"', '\\\\');\nfclose($file);\nusleep($sleepval);",
                "sourceLanguageId": "",
                "specification": "takes a Packet from ip_word, serializes it as a CSV record, and appends the result to \"ticker_out.csv\"",
                "specificationLanguageId": "markdown",
                "tests": "",
                "testsLanguageId": "json",
                "aiInstructions": "",
                "aiInstructionsLanguageId": "markdown"
            },
            "binaryContent": null,
            "technology": {
                "languageId": "",
                "technologyId": "",
